# PermiTrack Backend Configuration

# Application Environment (development, testing, production)
APP_ENV=development

# Flask Secret Key (Required for production)
SECRET_KEY=change-this-to-a-secure-random-key

# Database Connection URL (Supabase PostgreSQL / MySQL / SQLite)
# Example PostgreSQL: postgresql://user:password@host:5432/dbname?sslmode=require
# Example MySQL: mysql+pymysql://user:password@host:3306/dbname
DATABASE_URL=sqlite:///instance/app.db

# CORS Configuration (Allowed origins separated by comma, or * for all)
CORS_ALLOWED_ORIGINS=*

# Mail Settings (Optional: brevo_api or smtp)
MAIL_BACKEND=smtp
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com

# Brevo API (Alternative to SMTP)
# BREVO_API_KEY=your_brevo_api_key
# BREVO_SENDER_NAME="PermiTrack Support"

# Cloud Storage Configuration (local, s3, oci, or supabase)
STORAGE_BACKEND=local
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name
# STORAGE_ACCESS_KEY_ID=your-key-id
# STORAGE_SECRET_ACCESS_KEY=your-secret-key

# Database Auto Migration on Startup
AUTO_CREATE_TABLES=true
