# ==========================================
# 1. CORE APP SETTINGS
# ==========================================
FLASK_ENV=production
SECRET_KEY=generate_your_own_secret_key_here
SESSION_COOKIE_SECURE=True

# ==========================================
# 2. DATABASE SETTINGS (Supabase Connection Pooler)
# ==========================================
# IMPORTANT: Use the pooler URL (port 6543) to bypass local firewall blocks.
# Replace [PASSWORD] with your database password (no brackets).
DATABASE_URL=postgresql://postgres.oblbbtalypzmlflimxrz:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ==========================================
# 3. DATABASE INITIALIZATION & SEEDING (Temporary)
# ==========================================
ENABLE_INITDB_ROUTE=True
INITDB_TOKEN=MySuperSecureToken123
INIT_ADMIN_PASSWORD=change-me-admin

# ==========================================
# 4. STORAGE SETTINGS (Supabase S3 Upload Bucket)
# ==========================================
STORAGE_BACKEND=s3
STORAGE_BUCKET=permitrack
STORAGE_REGION=ap-southeast-1
STORAGE_ENDPOINT_URL=https://oblbbtalypzmlflimxrz.supabase.co/storage/v1/s3
STORAGE_ACCESS_KEY_ID=your_supabase_s3_access_key_id
STORAGE_SECRET_ACCESS_KEY=your_supabase_s3_secret_access_key

# ==========================================
# 5. MAIL TRANSFER SETTINGS (Gmail SMTP Option)
# ==========================================
# Set MAIL_DELIVERY_MODE to 'sync' so Vercel sends emails immediately.
MAIL_BACKEND=smtp
MAIL_DELIVERY_MODE=sync
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=permitrack.application@gmail.com
MAIL_PASSWORD=your_gmail_16_char_app_password
MAIL_DEFAULT_SENDER=permitrack.application@gmail.com

# ==========================================
# ALTERNATIVE: MAIL SETTINGS (Brevo API Option)
# ==========================================
# If you prefer Brevo instead of Gmail, uncomment these and comment out section 5.
# MAIL_BACKEND=brevo_api
# MAIL_DELIVERY_MODE=sync
# BREVO_API_KEY=your_brevo_api_key
# MAIL_DEFAULT_SENDER=your_verified_sender_email@domain.com
